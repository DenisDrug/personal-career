# Telegram bot already created on the server
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ID чата, куда отправлять заявки пользователей. Если пусто, используется TELEGRAM_CHAT_ID.
ADMIN_CHAT_IDS=
# Telegram user ID администраторов. Узнать свой можно командой /myid.
# Если пусто, используется TELEGRAM_CHAT_ID.
ADMIN_USER_IDS=
# Local-only test mode: allow only ADMIN_USER_IDS and do not create access requests.
TEST_MODE=false

# Search and matching
MATCH_THRESHOLD=0.60
SEARCH_TIMES=08:00,12:00,15:00,18:00
SEARCH_TIMEZONE=Europe/Minsk
REQUEST_TIMEOUT_SECONDS=20
# Scheduled searches are opt-in. Example: qa,pm
SCHEDULED_ROLES=
# Safety limit for one scheduled or manual search.
MAX_NOTIFICATIONS_PER_RUN=50
# Parallel profile matching workers. Keep 2 on the current 1-vCPU server.
SEARCH_WORKERS=2
# Detailed per-query source logs. Keep false on the server.
SOURCE_DEBUG_LOGS=false
# Instahyre is searched through a short headless Chromium session.
# Install locally with: pip install -e '.[browser]' && playwright install chromium-headless-shell
DATABASE_PATH=career.db
# Set DATABASE_URL to use PostgreSQL instead of the local SQLite fallback.
# DATABASE_URL=postgresql://personal_career:password@127.0.0.1:5432/personal_career

# Optional: comma-separated extra skills/aliases
EXTRA_SKILLS=
