# Telegram bot already created on the server
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ID чата, куда отправлять заявки пользователей. Если пусто, используется TELEGRAM_CHAT_ID.
ADMIN_CHAT_IDS=
# Telegram user ID администраторов. Узнать свой можно командой /myid.
# Если пусто, используется TELEGRAM_CHAT_ID.
ADMIN_USER_IDS=

# Search and matching
MATCH_THRESHOLD=0.60
SEARCH_TIMES=08:00,12:00,16:00,18:00
SEARCH_TIMEZONE=Europe/Minsk
REQUEST_TIMEOUT_SECONDS=20
DATABASE_PATH=career.db
# Set DATABASE_URL to use PostgreSQL instead of the local SQLite fallback.
# DATABASE_URL=postgresql://personal_career:password@127.0.0.1:5432/personal_career

# Optional: comma-separated extra skills/aliases
EXTRA_SKILLS=
