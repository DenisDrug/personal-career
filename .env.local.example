# Copy these database settings to the local .env after PostgreSQL starts.
DATABASE_URL=postgresql://personal_career:<local-password>@127.0.0.1:5433/personal_career
POSTGRES_PASSWORD=<local-password>
TEST_MODE=true
SCHEDULED_ROLES=
MAX_NOTIFICATIONS_PER_RUN=50
SOURCE_DEBUG_LOGS=false
# DATABASE_PATH=career.db remains as the SQLite fallback when DATABASE_URL is empty.
