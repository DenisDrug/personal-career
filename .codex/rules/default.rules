prefix_rule(pattern = ["git", ["commit", "push"]], decision = "prompt",
  justification = "Commit and push require explicit user approval.")
prefix_rule(pattern = ["git", "-C"], decision = "prompt",
  justification = "Git commands with an explicit repository path require user approval.")
prefix_rule(pattern = ["gh"], decision = "prompt",
  justification = "GitHub access and changes require explicit user approval.")
prefix_rule(pattern = ["docker", ["compose", "run", "exec", "start", "stop", "rm"]], decision = "prompt",
  justification = "Docker operations require explicit user approval.")
prefix_rule(pattern = ["ssh"], decision = "prompt",
  justification = "Server access requires explicit user approval.")
prefix_rule(pattern = ["scp"], decision = "prompt",
  justification = "Server file transfer requires explicit user approval.")
prefix_rule(pattern = ["rsync"], decision = "prompt",
  justification = "Remote file transfer requires explicit user approval.")
prefix_rule(pattern = ["systemctl"], decision = "prompt",
  justification = "Service management requires explicit user approval.")
prefix_rule(pattern = ["sudo"], decision = "prompt",
  justification = "Privileged commands require explicit user approval.")
prefix_rule(pattern = ["curl"], decision = "prompt",
  justification = "External network requests require explicit user approval.")
prefix_rule(pattern = ["wget"], decision = "prompt",
  justification = "External network requests require explicit user approval.")
prefix_rule(pattern = ["docker-compose"], decision = "prompt",
  justification = "Docker operations require explicit user approval.")
prefix_rule(pattern = ["pip", "install"], decision = "prompt",
  justification = "Dependency installation requires explicit user approval.")
prefix_rule(pattern = ["npm", "install"], decision = "prompt",
  justification = "Dependency installation requires explicit user approval.")
prefix_rule(pattern = ["uv"], decision = "prompt",
  justification = "Python environment and dependency changes require explicit user approval.")
